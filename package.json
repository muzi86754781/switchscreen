{
  "name": "switchscreen",
  "version": "0.7.0",
  "description": "跨平台软件 KVM：单显示器共用键鼠 + 快捷键切换 + 剪贴板跨机同步",
  "main": "electron/main.js",
  "bin": {
    "switchscreen": "src/cli.js"
  },
  "author": "switchscreen",
  "scripts": {
    "start": "node src/cli.js start",
    "record-hotkey": "node src/cli.js record-hotkey",
    "config": "node src/cli.js config",
    "dist:win": "electron-builder --win nsis --publish=never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish=never",
    "postinstall": "node -e \"console.log('[switchscreen] CI 会从源码编译 iohook/robotjs；本地若需编译请先装好 MSVC(X64)/Xcode 与 Python，再跑: npx electron-rebuild --force')\""
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "clipboardy": "^2.3.0",
    "iohook": "^0.9.3",
    "robotjs": "^0.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/rebuild": "^4.2.1"
  },
  "build": {
    "appId": "com.switchscreen.app",
    "productName": "SwitchScreen",
    "copyright": "Copyright © 2026 switchscreen",
    "files": [
      "src/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/ddc/**"
    ],
    "extraResources": [
      {
        "from": "build/tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "minimumSystemVersion": "11.0",
      "darkModeSupport": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "SwitchScreen 需要通过系统事件控制显示输入切换。",
        "NSAccessibilityUsageDescription": "SwitchScreen 需要辅助功能权限来共用键盘与鼠标。"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "dmg": {
      "title": "SwitchScreen"
    }
  },
  "license": "MIT"
}
